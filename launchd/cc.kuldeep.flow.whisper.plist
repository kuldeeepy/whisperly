<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cc.kuldeep.flow.whisper</string>

    <!-- Kept warm on purpose: a cold start costs ~1.0s to load the model and
         compile the Core ML encoder, which is most of the dictation budget. -->
    <key>ProgramArguments</key>
    <array>
        <string>__WHISPER_DIR__/build/bin/whisper-server</string>
        <string>--model</string>
        <string>__WHISPER_DIR__/models/ggml-large-v3-turbo.bin</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>__PORT__</string>
        <string>--threads</string>
        <string>4</string>
        <string>--language</string>
        <string>en</string>
        <string>--no-timestamps</string>
        <string>--suppress-nst</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WHISPER_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/whisper.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/whisper.err.log</string>
</dict>
</plist>
