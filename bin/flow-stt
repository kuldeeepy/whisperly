#!/bin/sh
# flow-stt <file.wav> — prints the transcript on stdout, nothing else.
#
# Exits non-zero with a message on stderr if the server is unreachable, so the
# caller can tell "server down" apart from "you recorded silence".

set -eu

WAV=${1:?usage: flow-stt <file.wav>}
URL=${FLOW_WHISPER_URL:-http://127.0.0.1:2032}

RESPONSE=$(
  curl -sS --fail --max-time 30 \
    -F file=@"$WAV" \
    -F temperature=0 \
    -F response_format=json \
    "$URL/inference"
) || {
  echo "flow-stt: no whisper server at $URL" >&2
  exit 1
}

printf '%s' "$RESPONSE" | jq -r '.text // empty'
